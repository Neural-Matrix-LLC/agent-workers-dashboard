# Copy to .env (next to agents.yaml) and fill in. .env is not committed.

# Password for the owner's login in the chat UI. The hub does not start without it.
HUB_OWNER_PASSWORD=

# One token per agent, named HUB_<AGENT ID>_TOKEN. Create one with: openssl rand -hex 32
# The hub reads these at start-up; a connector reads its own agent's token.
# (Alternative: `agent-hub token <agent>` stores a token's hash in the database instead.)
HUB_CLAUDE_TOKEN=
HUB_HERMES_TOKEN=

# Token Grok Bot sends to the hub.
# Goes in the Grok Bot connector as the header: Authorization: Bearer <token>
HUB_GROK_TOKEN=

# Grok Bot "Agent-Hub wake" routine. Copy both from its panel under Routines.
# The hub sends the key as the header: Authorization: Bearer <key>
GROK_WEBHOOK_URL=
GROK_WEBHOOK_KEY=

# Key of the Hermes API server (API_SERVER_KEY in ~/.hermes/.env). Read by the hermes connector.
HERMES_API_KEY=
